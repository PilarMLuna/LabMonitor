{
  "name": "@lab-monitor/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "predev": "pnpm --filter @lab-monitor/domain build",
    "dev": "tsx watch src/server.ts",
    "pretest": "pnpm --filter @lab-monitor/domain build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "pnpm --filter @lab-monitor/domain build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prebuild": "pnpm --filter @lab-monitor/domain build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@lab-monitor/domain": "workspace:*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.2"
  }
}
